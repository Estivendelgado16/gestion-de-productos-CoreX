PORT=3000

# Base de datos (Supabase - PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# JWT
JWT_SECRET=cambia-este-valor-por-uno-generado-aleatoriamente
JWT_EXPIRES_IN=1d

# Emails de administradores (separados por coma). Al iniciar sesión con uno de
# estos emails, el usuario recibe el rol admin.
# Ejemplo: ADMIN_EMAILS=admin@tolla.io,root@tolla.io
ADMIN_EMAILS=

# Pexels API (imágenes automáticas de productos). Se usa al crear un producto
# sin imágenes para buscar una foto que coincida con el nombre.
# Obtén una key gratuita en https://www.pexels.com/api/
PEXELS_API_KEY=
